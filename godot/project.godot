; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Test Subject Social"
config/description="Lethal party games for 2-4 subjects."
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

I18n="*res://src/core/i18n.gd"
Inputs="*res://src/core/input_manager.gd"
Sfx="*res://src/core/sfx.gd"
Haptics="*res://src/core/haptics.gd"
Commendations="*res://src/game/commendations.gd"
Net="*res://src/net/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/live_follow/plugin.cfg")

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.02, 1)
lights_and_shadows/positional_shadow/atlas_size=2048
