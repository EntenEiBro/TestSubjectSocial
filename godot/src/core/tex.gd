class_name Tex
## Library of the game's grungy textures (generated by tools/make_textures.py).
##
## Every accessor returns a texture reference {tex, rep} where `rep` is the
## tiling (like THREE's texture.repeat); Mats.mat() applies it as UV scale:
##   Mats.mat(0xffffff, Tex.rust(Vector2(4, 1)))

static var _cache := {}


static func load_tex(tex_name: String) -> Texture2D:
	if not _cache.has(tex_name):
		_cache[tex_name] = load("res://assets/textures/%s.png" % tex_name)
	return _cache[tex_name]


static func _ref(tex_name: String, rep: Variant) -> Dictionary:
	var r := Vector2.ONE
	if rep is Vector2:
		r = rep
	elif rep is Array and rep.size() >= 2:
		r = Vector2(float(rep[0]), float(rep[1]))
	elif rep is float or rep is int:
		r = Vector2(float(rep), float(rep))
	return {"tex": load_tex(tex_name), "rep": r}


## Look a texture up by name ("concrete", "plate", ...), as used by Env.floor().
static func named(tex_name: String, rep: Variant = null) -> Dictionary:
	return _ref(tex_name, rep)


## Procedural texture painted once with CanvasItem calls (port of canvasTexture):
##   Tex.canvas("incin-belt", 32, func(ci: CanvasItem, s: float): ci.draw_rect(...), Vector2(1, 6))
## Cached by key (shared across rounds). Returns {tex, rep} like the others.
static func canvas(key: String, size: int, paint: Callable, rep: Variant = null, transparent: bool = false) -> Dictionary:
	var ck := "canvas:" + key
	if not _cache.has(ck):
		_cache[ck] = _paint_texture(Vector2i(size, size), paint, transparent)
	var d := _ref("concrete", rep)
	d.tex = _cache[ck]
	return d


## Pixel-level procedural texture (noise, grime): paint(img: Image, size) on an RGBA8 image.
static func image(key: String, size: int, paint: Callable, rep: Variant = null) -> Dictionary:
	var ck := "image:" + key
	if not _cache.has(ck):
		var img := Image.create(size, size, true, Image.FORMAT_RGBA8)
		paint.call(img, size)
		img.generate_mipmaps()
		_cache[ck] = ImageTexture.create_from_image(img)
	var d := _ref("concrete", rep)
	d.tex = _cache[ck]
	return d


## Text painted onto a texture (port of textTexture; not cached).
## opts: w (256), h (128), font ("ops" | "vt" | "elite"), size (80), color ("#d8d2c0"), bg (null), grimy (true)
static func text(txt: String, opts: Dictionary = {}) -> Texture2D:
	var w: int = opts.get("w", 256)
	var h: int = opts.get("h", 128)
	var font := UI.font(opts.get("font", "ops"))
	var fs: int = opts.get("size", 80)
	var fit: float = (w * 0.92) / maxf(1.0, font.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fs).x)
	if fit < 1.0:
		fs = int(fs * fit)
	var color := U.col(opts.get("color", "#d8d2c0"))
	var bg = opts.get("bg", null)
	var grimy: bool = opts.get("grimy", true)
	return _paint_texture(Vector2i(w, h), func(ci: CanvasItem, _s):
		if bg != null:
			ci.draw_rect(Rect2(0, 0, w, h), U.col(bg))
		var sz := font.get_string_size(txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fs)
		ci.draw_string(font, Vector2((w - sz.x) / 2.0, h / 2.0 + fs * 0.35), txt, HORIZONTAL_ALIGNMENT_LEFT, -1, fs, color)
		if grimy:
			var rng := RandomNumberGenerator.new()
			for i in 260:
				ci.draw_rect(Rect2(rng.randf_range(0, w), rng.randf_range(0, h), rng.randf_range(1, 4), rng.randf_range(1, 4)), Color(0, 0, 0, rng.randf() * 0.6)), bg == null)


class _Painter extends Control:
	var fn: Callable
	func _draw() -> void:
		fn.call(self, size.x)


static var _holder: Node = null


## Render paint(ci, size_x) once into a persistent SubViewport and return its texture.
static func _paint_texture(px: Vector2i, paint: Callable, transparent: bool) -> Texture2D:
	if _holder == null or not is_instance_valid(_holder):
		_holder = Node.new()
		_holder.name = "PaintedTextures"
		(Engine.get_main_loop() as SceneTree).root.add_child.call_deferred(_holder)
	var vp := SubViewport.new()
	vp.size = px
	vp.disable_3d = true
	vp.transparent_bg = transparent
	vp.render_target_update_mode = SubViewport.UPDATE_ONCE
	var p := _Painter.new()
	p.fn = paint
	p.size = Vector2(px)
	vp.add_child(p)
	_holder.add_child(vp)
	return vp.get_texture()


static func concrete(rep: Variant = null) -> Dictionary: return _ref("concrete", rep)
static func wall(rep: Variant = null) -> Dictionary: return _ref("wall", rep)
static func tiles(rep: Variant = null) -> Dictionary: return _ref("tiles", rep)
static func metal(rep: Variant = null) -> Dictionary: return _ref("metal", rep)
static func plate(rep: Variant = null) -> Dictionary: return _ref("plate", rep)
static func rust(rep: Variant = null) -> Dictionary: return _ref("rust", rep)
static func wood(rep: Variant = null) -> Dictionary: return _ref("wood", rep)
static func crate(rep: Variant = null) -> Dictionary: return _ref("crate", rep)
static func hazard(rep: Variant = null) -> Dictionary: return _ref("hazard", rep)
static func fabric(rep: Variant = null) -> Dictionary: return _ref("fabric", rep)
static func dirt(rep: Variant = null) -> Dictionary: return _ref("dirt", rep)
static func blood(rep: Variant = null) -> Dictionary: return _ref("blood", rep)
